{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["index.ts", "types.ts", "templates.ts", "storage.ts", "quiz.ts"],
  "exclude": ["dist", "node_modules", "*.js", "*.d.ts"]
}
