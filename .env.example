# Copy to .env at repo root (gitignored): cp .env.example .env
# API (outline LLM + L2 embeddings) and worker both read these.

# OpenAI — used for chat (outline/generate) and L2 embeddings
OPENAI_API_KEY=sk-......
OPENAI_MODEL=gpt-4o-mini

# Or Anthropic (chat only, when OPENAI_API_KEY is unset)
# ANTHROPIC_API_KEY=

# L2 semantic cache (requires OPENAI_API_KEY for embeddings)
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_STRICT_SLIDES_THRESHOLD=0.97

# Optional
# REDIS_URL=redis://localhost:6379
# WORKER_CONCURRENCY=3
